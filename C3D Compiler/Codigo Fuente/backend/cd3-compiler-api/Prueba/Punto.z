public class Punto {
    int x;
    int y;

    public Punto(int px, int py) {
        x = px;
        y = py;
    }

    public Punto() {
        x = 0;
        y = 0;
    }

    public int getX() {
        return x;
    }

    public int getY() {
        return y;
    }

    public int restarX(Punto otro) {
        return x - otro.getX();
    }

    public int sumar(int n) {
        return x + y + n;
    }

    public int sumar(Punto otro) {
        return x + y + otro.x + otro.y;
    }

    public boolean esIgual(Punto otro) {
        return x == otro.x && y == otro.y;
    }
}
