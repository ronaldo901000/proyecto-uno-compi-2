// Estudiante hereda nombre y edad de Persona
public class Estudiante extends Persona {
    // private: el arreglo de notas no se toca desde fuera de la clase
    private int[] notas;

    public Estudiante(String nombre, int edad) {
        this.nombre = nombre;
        this.setEdad(edad);
        this.notas = new int[5];
    }

    public Estudiante() {
        this.nombre = "Sin nombre";
        this.setEdad(0);
        this.notas = new int[5];
    }

    // Asigna una nota en una posicion especifica (0 a 4)
    public void asignarNota(int posicion, int valor) {
        if (this.posicionValida(posicion)) {
            this.notas[posicion] = valor;
        }
    }

    // Retorna el arreglo de notas (por referencia)
    public int[] obtenerNotas() {
        return this.notas;
    }

    public double calcularPromedio() {
        int suma = 0;
        int i = 0;
        for (i = 0; i < 5; i++) {
            suma = suma + this.notas[i];
        }
        double promedio = suma / 5;
        return promedio;
    }

    public int notaMasAlta() {
        int mayor = this.notas[0];
        int i = 0;
        for (i = 1; i < 5; i++) {
            if (this.notas[i] > mayor) {
                mayor = this.notas[i];
            }
        }
        return mayor;
    }

    public int notaMasBaja() {
        int menor = this.notas[0];
        int i = 0;
        for (i = 1; i < 5; i++) {
            if (this.notas[i] < menor) {
                menor = this.notas[i];
            }
        }
        return menor;
    }

    // private: validacion interna, solo usable dentro de Estudiante
    private boolean posicionValida(int posicion) {
        return posicion >= 0 && posicion < 5;
    }

    // Polimorfismo: sobreescribe mostrarDatos() de Persona
    @Override
    public void mostrarDatos() {
        println("[Estudiante]");
        println("Nombre: " + this.nombre);
        println("Edad: " + this.getEdad());
        println("Promedio: " + this.calcularPromedio());
    }
}
