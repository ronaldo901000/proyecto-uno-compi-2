public class Asignatura {
    // Todos los atributos son private: se accede mediante metodos publicos
    private Estudiante[] asignados;
    private String nombre;
    private boolean hayAsignados;
    private int totalEstudiantes;
    private Docente titular;

    public Asignatura(String nombre) {
        this.nombre = nombre;
        this.asignados = new Estudiante[5];
        this.hayAsignados = false;
        this.totalEstudiantes = 0;
        this.titular = new Docente();
    }

    public Asignatura() {
        this.nombre = "Sin asignar";
        this.asignados = new Estudiante[5];
        this.hayAsignados = false;
        this.totalEstudiantes = 0;
        this.titular = new Docente();
    }

    // Getters y setters
    public String getNombre() {
        return this.nombre;
    }

    public int getTotalEstudiantes() {
        return this.totalEstudiantes;
    }

    public boolean getHayAsignados() {
        return this.hayAsignados;
    }

    public Docente getTitular() {
        return this.titular;
    }

    public void setTitular(Docente titular) {
        this.titular = titular;
    }

    // Reemplaza el acceso directo curso.asignados[i] que habia en main.pig
    public Estudiante obtenerEstudiante(int indice) {
        if (indice >= 0 && indice < this.totalEstudiantes) {
            return this.asignados[indice];
        }
        return null;
    }

    // default (sin modificador): solo clases del mismo paquete "modelo"
    boolean hayCupo() {
        return this.totalEstudiantes < 5;
    }

    public boolean agregarEstudiante(Estudiante nuevo) {
        if (!this.hayCupo()) {
            print("El curso ya esta lleno, no se pueden agregar mas estudiantes");
        } else {
            this.asignados[this.totalEstudiantes] = nuevo;
            this.totalEstudiantes++;
            this.hayAsignados = true;
        }
        return this.hayAsignados;
    }

    public double promedioGeneral() {
        if (this.totalEstudiantes == 0) {
            return 0.0;
        }
        double suma = 0.0;
        int i = 0;
        for (i = 0; i < this.totalEstudiantes; i++) {
            suma = suma + this.asignados[i].calcularPromedio();
        }
        double resultado = suma / this.totalEstudiantes;
        return resultado;
    }

    public void mostrarEstudiantes() {
        int i = 0;
        for (i = 0; i < this.totalEstudiantes; i++) {
            println("--- Estudiante " + i + " ---");
            this.asignados[i].mostrarDatos();
        }
    }

    // Polimorfismo: recibe Persona, ejecuta la version de Estudiante o Docente
    public void presentar(Persona p) {
        p.mostrarDatos();
    }
}
